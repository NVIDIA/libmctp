#!/bin/sh

printf '%10s|%5s|%50s|%-10s\n' "Transport" "EID" "UUID" "Supported MCTP Types"

# Look for the new service name pattern
SERVICES=$(busctl list --no-pager | awk '{print $1}' | grep "au.com.codeconstruct.MCTP")

for SERVICE in $SERVICES; do
    # New structure: endpoints are under /au/com/codeconstruct/mctp1/networks/1/endpoints/
    OBJECTS=$(busctl tree "$SERVICE" | grep "/au/com/codeconstruct/mctp1/networks/1/endpoints/" | awk -F' |-' '{print $NF}' | grep -v "^$")

    # Loop through each endpoint
    for OBJECT_PATH in $OBJECTS; do
        if [ -n "$OBJECT_PATH" ]; then
            # Initialize variables
            BINDING=""
            UUID=""
            MSG_TYPES=""
            EID=""
            CONNECTIVITY=""
            
            # Get all interfaces for the object
            INTERFACES=$(busctl introspect "$SERVICE" "$OBJECT_PATH" 2>/dev/null | grep "interface" | awk '{print $1}')

            # Loop through each interface
            for INTERFACE in $INTERFACES; do
                if [ "$INTERFACE" = "au.com.codeconstruct.MCTP.Endpoint1" ]; then
                    CONNECTIVITY=$(busctl get-property "$SERVICE" "$OBJECT_PATH" "$INTERFACE" Connectivity 2>/dev/null | awk '{print $2}')
                    CONNECTIVITY="${CONNECTIVITY%\"}"
                    CONNECTIVITY="${CONNECTIVITY#\"}"
                elif [ "$INTERFACE" = "xyz.openbmc_project.MCTP.Binding" ]; then
                    BINDING=$(busctl get-property "$SERVICE" "$OBJECT_PATH" "$INTERFACE" BindingType 2>/dev/null | awk '{print $2}' | awk -F '.' '{print $NF}')
                    BINDING="${BINDING%\"}"
                    BINDING="${BINDING#\"}"
                elif [ "$INTERFACE" = "xyz.openbmc_project.Common.UUID" ]; then
                    UUID=$(busctl get-property "$SERVICE" "$OBJECT_PATH" "$INTERFACE" UUID 2>/dev/null | awk '{print $2}')
                elif [ "$INTERFACE" = "xyz.openbmc_project.MCTP.Endpoint" ]; then
                    MSG_TYPES=$(busctl get-property "$SERVICE" "$OBJECT_PATH" "$INTERFACE" SupportedMessageTypes 2>/dev/null | awk '{$1=$2=""; print $0}')
                    EID=$(busctl get-property "$SERVICE" "$OBJECT_PATH" "$INTERFACE" EID 2>/dev/null | awk '{print $2}')
                fi
            done
            
            # Print only if we have an EID
            if [ -n "$EID" ]; then
                printf '%10s|%5s|%50s|%-10s\n' "$BINDING" "$EID" "$UUID" "$MSG_TYPES"
            fi
        fi
    done
done
